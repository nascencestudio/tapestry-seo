{
  "name": "@nascencestudio/tapestry-seo",
  "version": "0.2.0",
  "description": "SEO for Tapestry sites on StudioCMS: robots.txt with an admin-controlled crawler list (AI bots included), sitemap.xml, and per-page SEO settings",
  "license": "MIT",
  "author": "Nascence Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nascencestudio/tapestry-seo.git"
  },
  "homepage": "https://github.com/nascencestudio/tapestry-seo#readme",
  "bugs": {
    "url": "https://github.com/nascencestudio/tapestry-seo/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Seo.astro": "./dist/runtime/Seo.astro",
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "update-bots": "node scripts/update-bots.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@nascencestudio/tapestry": "^0.4.0",
    "astro": "^7.0.0",
    "studiocms": "^0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nascencestudio/tapestry": "0.4.0",
    "@types/node": "22.20.4",
    "astro": "7.4.0",
    "studiocms": "0.6.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "astro",
    "studiocms",
    "studiocms-plugin",
    "tapestry",
    "seo",
    "robots.txt",
    "sitemap",
    "ai-crawlers"
  ],
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "preact": "10.29.8"
  }
}
